// Prisma Schema for CHANDHANA SHOE MART
// Compatible with both SQLite (for zero-dependency local dev) and PostgreSQL (for production)

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String    @id @default(uuid())
  name      String
  email     String    @unique
  password  String
  role      String    @default("CUSTOMER") // "CUSTOMER" | "ADMIN"
  phone     String?
  avatar    String?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  addresses Address[]
  orders    Order[]
  reviews   Review[]
  wishlists Wishlist[]

  @@index([email])
}

model Address {
  id         String   @id @default(uuid())
  userId     String
  fullName   String
  phone      String
  street     String
  city       String
  state      String
  postalCode String
  country    String   @default("India")
  isDefault  Boolean  @default(false)
  type       String   @default("HOME") // "HOME" | "WORK"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Category {
  id          String    @id @default(uuid())
  name        String
  slug        String    @unique
  department  String    // "MEN" | "WOMEN" | "KIDS" | "SLIPPERS_SANDALS"
  description String?
  imageUrl    String?
  featured    Boolean   @default(false)
  order       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  products Product[]

  @@index([department])
  @@index([slug])
}

model Product {
  id              String   @id @default(uuid())
  title           String
  slug            String   @unique
  brand           String   @default("Chandhana")
  sku             String   @unique
  categoryId      String
  department      String   // "MEN" | "WOMEN" | "KIDS" | "SLIPPERS_SANDALS"
  price           Float
  originalPrice   Float?
  discountPercent Int      @default(0)
  description     String
  details         String?
  rating          Float    @default(4.8)
  reviewCount     Int      @default(0)
  isFeatured      Boolean  @default(false)
  isTrending      Boolean  @default(false)
  isNewArrival    Boolean  @default(false)
  isBestSeller    Boolean  @default(false)
  has3D           Boolean  @default(false)
  model3DConfig   String?  // JSON string: modelType, baseColor, accentColor, soleColor, roughness, etc.
  videoUrl        String?
  videoPoster     String?
  upperMaterial   String?
  soleMaterial    String?
  insoleMaterial  String?
  cushioning      String?
  closureType     String?
  heelHeight      String?
  weight          String?
  gripType        String?
  careInstructions String?
  warranty        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  category   Category         @relation(fields: [categoryId], references: [id])
  variants   ProductVariant[]
  media      ProductMedia[]
  reviews    Review[]
  orderItems OrderItem[]
  wishlists  Wishlist[]

  @@index([department])
  @@index([categoryId])
  @@index([isFeatured])
  @@index([isTrending])
  @@index([isNewArrival])
  @@index([isBestSeller])
}

model ProductVariant {
  id              String   @id @default(uuid())
  productId       String
  sku             String   @unique
  colorName       String
  colorHex        String
  size            String   // e.g., "UK 6", "UK 7", "UK 8", "UK 9", "UK 10", "UK 11"
  inventory       Int      @default(10)
  priceAdjustment Float    @default(0)
  imageUrl        String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([sku])
  @@index([size])
  @@index([colorName])
}

model ProductMedia {
  id        String   @id @default(uuid())
  productId String
  url       String
  type      String   @default("IMAGE") // "IMAGE" | "VIDEO"
  alt       String?
  order     Int      @default(0)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
}

model Wishlist {
  id        String   @id @default(uuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
}

model Order {
  id                String      @id @default(uuid())
  orderNumber       String      @unique
  userId            String?
  guestEmail        String?
  guestName         String?
  guestPhone        String?
  subtotal          Float
  discountAmount    Float       @default(0)
  shippingFee       Float       @default(0)
  taxAmount         Float       @default(0)
  totalAmount       Float
  couponCode        String?
  status            String      @default("PLACED") // "PLACED" | "CONFIRMED" | "PROCESSING" | "PACKED" | "SHIPPED" | "OUT_FOR_DELIVERY" | "DELIVERED" | "CANCELLED" | "RETURN_REQUESTED" | "RETURNED"
  paymentStatus     String      @default("PENDING") // "PENDING" | "PAID" | "FAILED" | "REFUNDED"
  paymentMethod     String      @default("COD") // "COD" | "RAZORPAY"
  paymentId         String?
  razorpayOrderId   String?
  razorpayPaymentId String?
  shippingAddress   String      // JSON stringified address
  trackingNumber    String?
  courierName       String?
  estimatedDelivery String?
  cancelReason      String?
  returnReason      String?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  user  User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  items OrderItem[]

  @@index([userId])
  @@index([orderNumber])
  @@index([status])
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  variantId    String?
  productTitle String
  sku          String
  colorName    String
  size         String
  unitPrice    Float
  quantity     Int
  totalPrice   Float
  imageUrl     String?

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productId])
}

model Review {
  id        String   @id @default(uuid())
  productId String
  userId    String
  userName  String
  rating    Int
  title     String
  comment   String
  verified  Boolean  @default(true)
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@index([userId])
}

model Coupon {
  id            String    @id @default(uuid())
  code          String    @unique
  discountType  String    @default("PERCENTAGE") // "PERCENTAGE" | "FIXED"
  value         Float
  minOrderValue Float     @default(0)
  maxDiscount   Float?
  isActive      Boolean   @default(true)
  expiresAt     DateTime?
  createdAt     DateTime  @default(now())

  @@index([code])
}

model StoreSettings {
  id                    String   @id @default("store-default")
  shopName              String   @default("Chandhana Shoe Mart")
  logoUrl               String?
  tagline               String   @default("Step Into Style with Chandhana Shoe Mart")
  phone                 String   @default("+91 98765 43210")
  email                 String   @default("support@chandhanashoemart.com")
  address               String   @default("Main Commercial Street, Bangalore, Karnataka, India")
  whatsapp              String   @default("+91 98765 43210")
  freeShippingThreshold Float    @default(999)
  standardShippingFee   Float    @default(99)
  announcement          String   @default("🎉 Grand Season Sale: Up to 50% Off on Premium Footwear! Free delivery on orders over ₹999.")
  updatedAt             DateTime @updatedAt
}
